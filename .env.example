# Settings for the swing book. Copy to .env and fill in; git ignores .env.
# The paper gateway's own login goes in .env.paper (TWS_USERID= and TWS_PASSWORD= of the paper username).

# The paper account. Orders go out only with FR_PAPER_SEND=1; otherwise every job is a dry run.
FR_PAPER_ACCOUNT=DU0000000
# FR_PAPER_PORT=4002
# FR_PAPER_SEND=1

# The research passes sign in to Claude Code with this (from `claude setup-token`).
# FR_CLAUDE_TOKEN=

# Phone alerts from the watchdog (fr watch): an ntfy topic, and a Telegram bot and chat.
# FR_NTFY_TOPIC=
# FR_TELEGRAM_TOKEN=
# FR_TELEGRAM_CHAT=

# Where market data is stored; defaults to data/ in the repo.
# FR_DATA_ROOT=

# SEC EDGAR contact header (required by sec.gov, free, no API key): Name + email alias.
# SEC_USER_AGENT="ETF-Factor-Rotation you@example.com"
