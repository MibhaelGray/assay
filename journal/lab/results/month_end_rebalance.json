{
 "idea": {
  "id": "month_end_rebalance",
  "family": "calendar",
  "title": "At month end, lean against whichever of shares and bonds won the month",
  "why": "Pension and balanced funds hold fixed mixes of shares and bonds and trade back to them at month end. After a month in which shares beat bonds by a lot they must sell shares and buy bonds in the last days, and the reverse. The size of the flow is known from the month's returns before it happens. Trade the index fund against the long bond fund for the last few sessions, in the direction the rebalancing pushes.",
  "source": "Etula, Rinne, Suominen, Vaittinen 2020 (Dash for Cash); Harvey et al. 2021 on rebalancing flows",
  "market": "us",
  "universe": {
   "funds": [
    "SPY",
    "TLT"
   ]
  },
  "base": {
   "side": "ls",
   "select": "sign",
