{
 "idea": {
  "id": "rev_volume@jp",
  "family": "reversal",
  "title": "Quiet moves reverse, loud moves carry on",
  "why": "A price move on thin volume is more likely to be one trader's pressure, which fades; a move on heavy volume is more likely to be news, which the price keeps adjusting to (Llorente, Michaely, Saar, Wang 2002). So fade the week's residual move when the week's volume was below normal, and follow it when volume was well above.",
  "source": "Llorente et al. 2002; Campbell, Grossman, Wang 1993",
  "market": "jp",
  "universe": {
   "min_price": 5,
   "min_adv": 20000000.0,
   "top": 1000
  },
  "base": {
   "side": "ls",
   "frac": 0.1,
   "hold": 3,
   "lookback": 5,
   "mode": "quiet_fade"
  },
