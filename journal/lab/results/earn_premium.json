{
 "idea": {
  "id": "earn_premium",
  "family": "earnings",
  "title": "Own stocks over their earnings report, hedged with the market",
  "why": "Stocks earn more than usual in the days around their report, on average and whatever the news: a report draws attention and buying from people who cannot easily short, and holders are paid for carrying the uncertainty (Beaver 1968; Frazzini and Lamont 2007; Barber, De George, Lehavy, Trueman 2013). Report dates are known weeks ahead, so this needs no forecast. The run-up variant owns the week before and leaves before the news.",
  "source": "Frazzini and Lamont 2007; Barber et al. 2013",
  "market": "us",
  "universe": {
   "min_price": 5,
   "min_adv": 10000000.0
  },
  "base": {
   "side": "long",
   "select": "sign",
   "hedge": true,
   "hold": 2,
   "entry": "close",
   "mode": "over",
   "max_w": 0.05
  },
