{
 "idea": {
  "id": "news_day_drift",
  "family": "momentum",
  "title": "A huge move on huge volume that closes at its extreme keeps going for a few days",
  "why": "A move of three or more of a stock's own daily ranges on several times its normal volume is almost always news. Prices are slow to take in news in full (the same slowness behind the drift after earnings), and a close at the day's extreme says the buying or selling had not finished by the bell. Follow it from the next open.",
  "source": "Chan 2003 (news and drift); Bernard and Thomas 1989; this project's small-cap study found the opposite sign in $250M-$1B names",
  "market": "us",
  "universe": {
   "min_price": 5,
   "min_adv": 10000000.0
  },
