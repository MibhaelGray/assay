{
 "idea": {
  "id": "earn_premium_window",
  "family": "earnings",
  "title": "Where in the window the earnings-report premium is earned: before the report or over it",
  "why": "Follow-up to `earn_premium_sharp:early_entry`, the one change that helped (0.76 to 0.86 after costs, 24 to 29 bp a round trip before costs, by entering one session earlier). Two stories give the same average and different trades. If the premium is attention building (buyers arriving ahead of a known date), it should keep growing as the entry moves earlier, and a good part should be earned before the report, where there is no earnings gap to carry and the risk is a fraction of the report day's. If it is pay for carrying the report's uncertainty, the days before should be empty and the premium should sit on the report sessions alone. `pre_1d` and `pre_2d` own only the sessions before the report date and are out at the close before it. `from_3d` and `from_4d` enter three and four sessions ahead and hold through the report as before. Same high-attention names, same universe, nothing else changed. Four variants, fixed before running; the first session's plain run-up test (all names, 3 and 5 sessions, 0.2-0.3 before costs) says not to expect much from the days before.",
  "source": "Frazzini and Lamont 2007; Barber, De George, Lehavy, Trueman 2013; lab session 2026-11-22",
  "market": "us",
  "universe": {
   "min_price": 5,
   "min_adv": 10000000.0
  },
  "base": {
   "side": "long",
   "select": "sign",
   "hedge": true,
   "hold": 1,
   "entry": "close",
   "max_w": 0.05,
   "lead": 2
  },
  "variants": {
   "pre_1d": {},
