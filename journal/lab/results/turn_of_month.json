{
 "idea": {
  "id": "turn_of_month",
  "family": "calendar",
  "title": "Hold the index only around the turn of the month",
  "why": "Pay cheques, pension contributions and month-end rebalancing put money into shares in a few days around the month's end. Since Ariel (1987) and Lakonishok and Smidt (1988) most of the market's return has come in the last day of the month and the first three of the next. The trade is in the market four days in twenty-one, so the test is whether those days still earn more than the rest.",
  "source": "Ariel 1987; Lakonishok and Smidt 1988; McConnell and Xu 2008",
  "market": "us",
  "universe": {
   "funds": [
    "SPY",
    "IWM",
    "QQQ"
   ]
  },
  "base": {
   "side": "long",
   "select": "sign",
   "hold": 1,
   "entry": "close",
   "max_w": 1.0,
   "fund": "SPY",
   "before": 1,
   "after": 3
  },
  "variants": {
