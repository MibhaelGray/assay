{
 "idea": {
  "id": "earn_drift",
  "family": "earnings",
  "title": "After an earnings report the market liked (or hated), follow it for a few days",
  "why": "Prices keep moving in the direction of an earnings surprise for weeks (Ball and Brown 1968; Bernard and Thomas 1989), and the first days carry the largest share. The market's own reaction on the day is a better read of the surprise than the headline number (Chan, Jegadeesh, Lakonishok 1996; Brandt et al. 2008), and agreement between the two should be best. The drift has shrunk in large stocks; smaller ones are where it should survive.",
  "source": "Bernard and Thomas 1989; Brandt, Kishore, Santa-Clara, Venkatachalam 2008 (earnings announcement return)",
  "market": "us",
  "universe": {
   "min_price": 5,
   "min_adv": 5000000.0
  },
